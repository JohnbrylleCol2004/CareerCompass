# EAS uses this file instead of .gitignore; keep the existing exclusions.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/ios
/android

# Agent skills are development tooling. Windows exposes .claude/skills as
# junctions to .agents/skills, which EAS cannot copy into its shallow clone.
/.agents/
/.claude/
/.codex/
